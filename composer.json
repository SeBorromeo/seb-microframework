{
  "name": "sebastian/seb-microframework",
  "description": "'Seb', a lightweight PHP micro-framework inspired by Express",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Sebastian\\MicroFramework\\": "src/"
    }
  },
  "require": {
    "php": "^8.1",
    "pug-php/pug": "^3.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.2"
  },
  "config": {
    "allow-plugins": {
      "nodejs-php-fallback/nodejs-php-fallback": true
    }
  }
}
